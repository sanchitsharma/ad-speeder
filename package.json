{
  "name": "ad-speeder",
  "version": "1.0.0",
  "description": "Chrome extension that fast-forwards, mutes and skips video ads on YouTube and Prime Video",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 tests/mock.test.mjs",
    "test:live-youtube": "node tests/youtube-live.mjs",
    "test:live-youtube-dom": "node tests/youtube-live-dom.mjs",
    "test:live-prime": "node tests/prime-live.mjs",
    "package": "python3 -c \"import shutil; shutil.make_archive('ad-speeder','zip','extension')\" && echo built ad-speeder.zip",
    "lint": "eslint . && prettier --check extension tests",
    "format": "prettier --write extension tests && eslint --fix .",
    "assets": "node store/capture-popup.mjs && node store/make-assets.mjs",
    "publish": "scripts/publish.sh"
  },
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "chrome-webstore-upload-cli": "^4.0.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.14.0",
    "playwright": "^1.65.0",
    "prettier": "^3.10.1"
  },
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/sanchitsharma/ad-speeder.git"
  }
}
