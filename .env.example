# Chrome Web Store API credentials for `npm run publish`. Copy to .env (gitignored).
# Guide: https://github.com/fregante/chrome-webstore-upload-keys
EXTENSION_ID=   # 32-letter item ID from the dashboard URL, after the first upload
PUBLISHER_ID=   # from the developer dashboard (Account section)
CLIENT_ID=
CLIENT_SECRET=
REFRESH_TOKEN=
