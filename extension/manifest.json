{
  "manifest_version": 3,
  "name": "Ad Speeder",
  "version": "1.3.0",
  "description": "Fast-forwards and mutes video ads on YouTube, Prime Video and SonyLIV, clicks Skip when it appears, then restores normal playback.",
  "minimum_chrome_version": "121",
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Ad Speeder",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*",
        "https://www.youtube-nocookie.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["https://*.primevideo.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.sonyliv.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
